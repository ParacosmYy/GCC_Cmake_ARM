{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ci: init",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "init"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "Scripts/ci/run_with_user_env.ps1",
                    "py",
                    "-3",
                    "Scripts/ci/main.py",
                    "init"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ci: build",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "build",
                "--preset",
                "Debug"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "Scripts/ci/run_with_user_env.ps1",
                    "py",
                    "-3",
                    "Scripts/ci/main.py",
                    "build",
                    "--preset",
                    "Debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "ci: check",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "check"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "Scripts/ci/run_with_user_env.ps1",
                    "py",
                    "-3",
                    "Scripts/ci/main.py",
                    "check"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "ci: flash",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "flash"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "Scripts/ci/run_with_user_env.ps1",
                    "py",
                    "-3",
                    "Scripts/ci/main.py",
                    "flash"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
