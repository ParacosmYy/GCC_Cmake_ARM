{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ci: init",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "init"
            ],
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "Scripts/ci/main.py",
                    "init"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "CMAKE": "${config:localCi.tools.cmake}",
                    "NINJA": "${config:localCi.tools.ninja}",
                    "CLANG_FORMAT": "${config:localCi.tools.clangFormat}",
                    "CPPCHECK": "${config:localCi.tools.cppcheck}",
                    "LEFTHOOK": "${config:localCi.tools.lefthook}",
                    "ARM_NONE_EABI_GCC": "${config:localCi.tools.armGcc}",
                    "ARM_NONE_EABI_OBJCOPY": "${config:localCi.tools.armObjcopy}",
                    "ARM_NONE_EABI_SIZE": "${config:localCi.tools.armSize}",
                    "OPENOCD": "${config:localCi.tools.openocd}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "ci: build",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "build",
                "--preset",
                "Debug"
            ],
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "Scripts/ci/main.py",
                    "build",
                    "--preset",
                    "Debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "CMAKE": "${config:localCi.tools.cmake}",
                    "NINJA": "${config:localCi.tools.ninja}",
                    "ARM_NONE_EABI_GCC": "${config:localCi.tools.armGcc}",
                    "ARM_NONE_EABI_OBJCOPY": "${config:localCi.tools.armObjcopy}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "ci: build-release",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "build",
                "--preset",
                "Release"
            ],
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "Scripts/ci/main.py",
                    "build",
                    "--preset",
                    "Release"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "CMAKE": "${config:localCi.tools.cmake}",
                    "NINJA": "${config:localCi.tools.ninja}",
                    "ARM_NONE_EABI_GCC": "${config:localCi.tools.armGcc}",
                    "ARM_NONE_EABI_OBJCOPY": "${config:localCi.tools.armObjcopy}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "ci: check",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "check"
            ],
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "Scripts/ci/main.py",
                    "check"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "CMAKE": "${config:localCi.tools.cmake}",
                    "NINJA": "${config:localCi.tools.ninja}",
                    "CLANG_FORMAT": "${config:localCi.tools.clangFormat}",
                    "CPPCHECK": "${config:localCi.tools.cppcheck}",
                    "ARM_NONE_EABI_GCC": "${config:localCi.tools.armGcc}",
                    "ARM_NONE_EABI_OBJCOPY": "${config:localCi.tools.armObjcopy}",
                    "ARM_NONE_EABI_SIZE": "${config:localCi.tools.armSize}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "ci: flash",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "flash"
            ],
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "Scripts/ci/main.py",
                    "flash"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "OPENOCD": "${config:localCi.tools.openocd}",
                    "OPENOCD_INTERFACE_CFG": "${config:localCi.debug.openocdInterfaceCfg}",
                    "OPENOCD_TARGET_CFG": "${config:localCi.debug.openocdTargetCfg}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "ci: clean",
            "type": "process",
            "command": "python3",
            "args": [
                "Scripts/ci/main.py",
                "clean"
            ],
            "windows": {
                "command": "py",
                "args": [
                    "-3",
                    "Scripts/ci/main.py",
                    "clean"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
