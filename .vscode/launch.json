{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${config:localCi.debug.elfPath}",
            "gdbPath": "${config:localCi.debug.gdbPath}",
            "serverpath": "${config:localCi.debug.openocdPath}",
            "configFiles": [
                "${config:localCi.debug.openocdInterfaceCfg}",
                "${config:localCi.debug.openocdTargetCfg}"
            ],
            "preLaunchTask": "ci: build",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "rtos": "FreeRTOS"
        }
    ]
}
