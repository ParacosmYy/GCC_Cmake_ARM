{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/__ARTIFACT_BASE_NAME__.elf",
            "gdbPath": "arm-none-eabi-gdb",
            "serverpath": "openocd",
            "configFiles": [
                "${env:OPENOCD_SCRIPTS}/__OPENOCD_INTERFACE_CFG__",
                "${env:OPENOCD_SCRIPTS}/__OPENOCD_TARGET_CFG__"
            ],
            "preLaunchTask": "ci: build",
            "runToEntryPoint": "main"
        }
    ]
}
