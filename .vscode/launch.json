{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32 (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
            "gdbPath": "arm-none-eabi-gdb",
            "serverpath": "openocd",
            "configFiles": [
                "${env:OPENOCD_SCRIPTS}/interface/cmsis-dap.cfg",
                "${env:OPENOCD_SCRIPTS}/target/stm32h7x.cfg"
            ],
            "preLaunchTask": "ci: build",
            "runToEntryPoint": "main",
            "rtos": "FreeRTOS"
        }
    ]
}
