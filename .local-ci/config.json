{
  "$schema": "./config.schema.json",
  "version": 1,
  "project": {
    "name": "TEST_VSCODE_LPUART1_2"
  },
  "build": {
    "root": "build",
    "presets": {
      "debug": "Debug",
      "release": "Release"
    }
  },
  "artifacts": {
    "base_name": "TEST_VSCODE_LPUART1_2",
    "generated_formats": [
      "bin",
      "hex"
    ]
  },
  "quality": {
    "format": {
      "include": [
        "App/**/*.c",
        "App/**/*.cc",
        "App/**/*.cpp",
        "App/**/*.cxx",
        "App/**/*.h",
        "App/**/*.hh",
        "App/**/*.hpp",
        "App/**/*.hxx",
        "Bsp/**/*.c",
        "Bsp/**/*.cc",
        "Bsp/**/*.cpp",
        "Bsp/**/*.cxx",
        "Bsp/**/*.h",
        "Bsp/**/*.hh",
        "Bsp/**/*.hpp",
        "Bsp/**/*.hxx",
        "Service/**/*.c",
        "Service/**/*.cc",
        "Service/**/*.cpp",
        "Service/**/*.cxx",
        "Service/**/*.h",
        "Service/**/*.hh",
        "Service/**/*.hpp",
        "Service/**/*.hxx",
        "Board/**/*.c",
        "Board/**/*.cc",
        "Board/**/*.cpp",
        "Board/**/*.cxx",
        "Board/**/*.h",
        "Board/**/*.hh",
        "Board/**/*.hpp",
        "Board/**/*.hxx",
        "Config/**/*.c",
        "Config/**/*.cc",
        "Config/**/*.cpp",
        "Config/**/*.cxx",
        "Config/**/*.h",
        "Config/**/*.hh",
        "Config/**/*.hpp",
        "Config/**/*.hxx",
        "Core/Inc/main.h",
        "Core/Src/main.c"
      ],
      "exclude": [
        "Drivers/**",
        "Middlewares/**",
        "build/**"
      ]
    },
    "lint": {
      "include": [
        "App/**/*.c",
        "App/**/*.cc",
        "App/**/*.cpp",
        "App/**/*.cxx",
        "Bsp/**/*.c",
        "Bsp/**/*.cc",
        "Bsp/**/*.cpp",
        "Bsp/**/*.cxx",
        "Service/**/*.c",
        "Service/**/*.cc",
        "Service/**/*.cpp",
        "Service/**/*.cxx",
        "Board/**/*.c",
        "Board/**/*.cc",
        "Board/**/*.cpp",
        "Board/**/*.cxx",
        "Config/**/*.c",
        "Config/**/*.cc",
        "Config/**/*.cpp",
        "Config/**/*.cxx",
        "Core/Src/main.c"
      ],
      "exclude": [
        "Drivers/**",
        "Middlewares/**",
        "build/**"
      ]
    }
  },
  "flash": {
    "default_preset": "Debug",
    "interface_cfg": "interface/cmsis-dap.cfg",
    "target_cfg": "target/stm32h7x.cfg"
  },
  "hooks": {
    "pre_commit": {
      "json_validate": [
        "CMakePresets.json",
        ".vscode/*.json",
        ".local-ci/*.json"
      ]
    }
  }
}
